// src/App.jsx
// Componente principal de la mini-aplicación.
// Tema: Catálogo de productos con carrito.
// Demuestra comunicación padre-hijo mediante props y funciones callback.

import { useState } from "react";
import ProductList from "./components/ProductList";
import CartClass from "./components/CartClass";
import ProductForm from "./components/ProductForm";
import "./App.css";

function App() {
  // Estado principal del componente padre.
  // Contiene los productos disponibles en el catálogo.
  const [products, setProducts] = useState([
    {
      id: 1,
      name: "Laptop Lenovo",
      price: 2800000,
      category: "Tecnología",
    },
    {
      id: 2,
      name: "Mouse Logitech",
      price: 95000,
      category: "Accesorios",
    },
    {
      id: 3,
      name: "Monitor Samsung",
      price: 720000,
      category: "Tecnología",
    },
  ]);

  // Estado interno del componente padre para almacenar productos agregados al carrito.
  const [cart, setCart] = useState([]);

  // Función callback enviada al componente hijo ProductList.
  // Permite que un hijo comunique al padre qué producto fue seleccionado.
  const handleAddToCart = (product) => {
    setCart([...cart, product]);
  };

  // Función callback enviada al componente hijo ProductForm.
  // Permite agregar un nuevo producto desde un formulario funcional con Hooks.
  const handleAddProduct = (newProduct) => {
    setProducts([
      ...products,
      {
        id: Date.now(),
        ...newProduct,
        price: Number(newProduct.price),
      },
    ]);
  };

  // Función callback enviada al Class Component CartClass.
  // Permite eliminar productos del carrito.
  const handleRemoveFromCart = (productId) => {
    const updatedCart = cart.filter((product) => product.id !== productId);
    setCart(updatedCart);
  };

  return (
    <main className="app-container">
      {/* Encabezado principal de la aplicación */}
      <header className="app-header">
        <h1>Catálogo de Productos</h1>
        <p>
          Mini-aplicación React aplicando componentes, props, estado,
          encapsulamiento y programación orientada a objetos.
        </p>
      </header>

      {/* Componente funcional con Hooks para crear productos */}
      <ProductForm onAddProduct={handleAddProduct} />

      {/* Componente funcional que recibe datos y callback por props */}
      <ProductList products={products} onAddToCart={handleAddToCart} />

      {/* Componente de clase que recibe props y maneja lógica propia */}
      <CartClass cart={cart} onRemoveFromCart={handleRemoveFromCart} />
    </main>
  );
}

export default App;
```

