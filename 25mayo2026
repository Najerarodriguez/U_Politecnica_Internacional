// src/components/CartClass.jsx
// Componente de clase.
// Demuestra programación orientada a objetos en React.
// Usa métodos internos para encapsular la lógica del carrito.

import { Component } from "react";

class CartClass extends Component {
  // Método encapsulado para calcular el valor total del carrito.
  calculateTotal() {
    return this.props.cart.reduce((total, product) => {
      return total + product.price;
    }, 0);
  }

  // Método encapsulado para eliminar un producto del carrito.
  handleRemove(productId) {
    this.props.onRemoveFromCart(productId);
  }

  render() {
    const { cart } = this.props;
    const total = this.calculateTotal();

    return (
      <section className="section-card">
        <h2>Carrito de compras</h2>

        {/* Renderizado condicional según el estado recibido desde App */}
        {cart.length === 0 ? (
          <p>No hay productos en el carrito.</p>
        ) : (
          <>
            <ul className="cart-list">
              {cart.map((product) => (
                <li key={`${product.id}-${Math.random()}`}>
                  <span>
                    {product.name} -{" "}
                    {product.price.toLocaleString("es-CO", {
                      style: "currency",
                      currency: "COP",
                    })}
                  </span>

                  <button onClick={() => this.handleRemove(product.id)}>
                    Eliminar
                  </button>
                </li>
              ))}
            </ul>

            <h3>
              Total:{" "}
              {total.toLocaleString("es-CO", {
                style: "currency",
                currency: "COP",
              })}
            </h3>
          </>
        )}
      </section>
    );
  }
}

export default CartClass;
