```jsx
// src/components/ProductForm.jsx
// Componente funcional con Hooks.
// Usa useState para manejar el estado interno del formulario.
// Envía el nuevo producto al componente padre mediante props.

import { useState } from "react";

function ProductForm({ onAddProduct }) {
  // Estado interno del formulario.
  // Cada campo representa una propiedad del producto.
  const [formData, setFormData] = useState({
    name: "",
    price: "",
    category: "",
  });

  // Función encapsulada para actualizar el estado del formulario.
  const handleChange = (event) => {
    const { name, value } = event.target;

    setFormData({
      ...formData,
      [name]: value,
    });
  };

  // Función encapsulada para validar y enviar los datos al componente padre.
  const handleSubmit = (event) => {
    event.preventDefault();

    // Validación básica para evitar productos incompletos.
    if (!formData.name || !formData.price || !formData.category) {
      alert("Todos los campos son obligatorios.");
      return;
    }

    // Se ejecuta la función callback recibida por props.
    onAddProduct(formData);

    // Se limpia el formulario después de agregar el producto.
    setFormData({
      name: "",
      price: "",
      category: "",
    });
  };

  return (
    <section className="section-card">
      <h2>Registrar nuevo producto</h2>

      <form className="product-form" onSubmit={handleSubmit}>
        <input
          type="text"
          name="name"
          placeholder="Nombre del producto"
          value={formData.name}
          onChange={handleChange}
        />

        <input
          type="number"
          name="price"
          placeholder="Precio"
          value={formData.price}
          onChange={handleChange}
        />

        <input
          type="text"
          name="category"
          placeholder="Categoría"
          value={formData.category}
          onChange={handleChange}
        />

        <button type="submit">Guardar producto</button>
      </form>
    </section>
  );
}

export default ProductForm;
